BOT_TOKEN=123456789:replace_with_token_from_BotFather
WEBHOOK_SECRET=replace_with_random_secret
# Telegram user IDs of Lina and Maksim, separated by commas (not usernames).
ADMIN_IDS=111111111,222222222
# Docker Compose exposes only this port on the host's loopback interface.
APP_PORT=3000
# The following HOST/PORT/DB_PATH settings are for npm start (without Docker).
# Compose uses HOST=0.0.0.0, PORT=3000, DB_PATH=/data/participants.sqlite inside the container.
HOST=127.0.0.1
PORT=3000
DB_PATH=./data/participants.sqlite
DISPLAY_TIMEZONE=Europe/Moscow
# Only used by npm run webhook:set, never registered automatically at startup.
WEBHOOK_URL=https://global.kolyach.me/telegram/webhook
